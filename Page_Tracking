// ==========================================
// 🔍 PAGE: Page_Tracking (หน้าต่างติดตามสถานะและประวัติงาน)
// ==========================================
function Page_Tracking() {
  document.getElementById('page-content').innerHTML = `
    <div class="space-y-4">
      <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col gap-3">
        <div class="flex items-center gap-2 border-b border-slate-100 pb-2">
          <div class="w-2 h-4 bg-[#0f172a] rounded-full"></div>
          <h2 class="text-sm font-bold text-slate-800">ติดตามและตรวจสอบสถานะใบงาน</h2>
        </div>
        
        <div class="relative">
          <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3.5 text-slate-400 text-xs"></i>
          <input type="text" id="searchBar" oninput="runFilter()" placeholder="ค้นหาชื่ออุปกรณ์, รหัสใบงาน หรือชื่อผู้แจ้ง..." class="w-full bg-[#f8fafc] border border-slate-200 rounded-xl py-2.5 pl-9 pr-4 text-xs text-slate-800 focus:outline-none focus:border-slate-500 focus:bg-white transition">
        </div>
        
        <div class="flex gap-1 overflow-x-auto text-[10px] font-bold scrollbar-none">
          <button onclick="setStatusFilter('All', this)" class="track-tab bg-[#0f172a] text-white px-3 py-2 rounded-lg shadow-sm whitespace-nowrap transition-all">ทั้งหมด</button>
          <button onclick="setStatusFilter('Pending', this)" class="track-tab bg-white border border-slate-200 text-slate-500 px-3 py-2 rounded-lg whitespace-nowrap transition-all">Pending</button>
          <button onclick="setStatusFilter('In-Progress', this)" class="track-tab bg-white border border-slate-200 text-slate-500 px-3 py-2 rounded-lg whitespace-nowrap transition-all">In-Progress</button>
          <button onclick="setStatusFilter('Completed', this)" class="track-tab bg-white border border-slate-200 text-slate-500 px-3 py-2 rounded-lg whitespace-nowrap transition-all">Completed</button>
        </div>
      </div>

      <div id="repairList" class="space-y-3">
        <div class="text-center py-12 text-slate-400 bg-white rounded-2xl border border-slate-200">
          <i class="fa-solid fa-rotate animate-spin text-lg text-[#0f172a] mb-1.5"></i>
          <p class="text-xs font-medium">กำลังเรียกดูรายการล่าสุดจาก Supabase...</p>
        </div>
      </div>
    </div>

    <div id="infoModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[9999] hidden flex items-center justify-center p-4">
      <div class="bg-white rounded-2xl w-full max-w-sm p-5 max-h-[85vh] overflow-y-auto space-y-4 shadow-2xl border border-slate-100 scale-95 transition-all">
        <div class="flex justify-between items-center border-b border-slate-100 pb-3">
          <div class="flex items-center gap-2 text-[#0f172a]">
            <i class="fa-solid fa-file-waveform text-xs text-slate-500"></i>
            <h3 class="font-bold text-slate-800 text-xs">รายละเอียดข้อมูลในระบบ</h3>
          </div>
          <button onclick="closeInfoModal()" class="w-7 h-7 bg-slate-100 text-slate-500 rounded-full flex items-center justify-center text-sm font-bold hover:bg-slate-200 transition">&times;</button>
        </div>
        <div id="infoModalBody" class="space-y-3 text-xs text-slate-600"></div>
        <button onclick="closeInfoModal()" class="w-full bg-[#0f172a] hover:bg-slate-800 text-white font-bold p-2.5 rounded-xl text-xs transition shadow-md">
          ปิดหน้าต่างนี้
        </button>
      </div>
    </div>
  `;

  // เรียกโหลดข้อมูลทันทีที่เปิดหน้านี้
  fetchList();
}

// ==========================================
// ⚙️ SYSTEM LOGIC FOR TRACKING & FILTER
// ==========================================
if (typeof globalRepairs === 'undefined') { var globalRepairs = []; }
var activeFilter = "All";

// 🔄 เปลี่ยนมาใช้ฟังก์ชัน getRepairs ที่ยิง Fetch ตรงเข้า Supabase
async function fetchList() {
  const data = await getRepairs();
  globalRepairs = data || [];
  runFilter();
}

function runFilter() {
  const searchBar = document.getElementById('searchBar');
  if (!searchBar) return; // ป้องกันบั๊กกรณีสลับหน้าไปแล้วแต่ระบบยังประมวลผลอยู่
  
  const txt = searchBar.value.toLowerCase();
  const list = document.getElementById('repairList');
  
  const filtered = globalRepairs.filter(item => {
    const matchSearch = (item.subject && item.subject.toLowerCase().includes(txt)) || 
                        (item.reporter_name && item.reporter_name.toLowerCase().includes(txt)) || 
                        (item.job_number && item.job_number.toLowerCase().includes(txt));
    const matchStatus = activeFilter === 'All' || item.status === activeFilter;
    return matchSearch && matchStatus;
  });

  if(filtered.length === 0) {
    list.innerHTML = `
      <div class="text-center py-12 bg-white rounded-2xl border border-slate-200 text-slate-400">
        <i class="fa-regular fa-folder-open text-2xl mb-2 text-slate-300"></i>
        <p class="text-xs font-medium">ไม่พบรายการข้อมูลที่ค้นหา</p>
      </div>`;
    return;
  }

  list.innerHTML = filtered.map(item => {
    const uColor = item.urgency === 'ด่วนมาก' ? 'bg-rose-50 text-rose-600 border-rose-100' : (item.urgency === 'ด่วน' ? 'bg-amber-50 text-amber-600 border-amber-100' : 'bg-slate-50 text-slate-600 border-slate-100');
    const sColor = item.status === 'Completed' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : (item.status === 'In-Progress' ? 'bg-amber-50 text-amber-700 border border-amber-200' : 'bg-slate-100 text-slate-700 border border-slate-200');
    
    const origIndex = globalRepairs.findIndex(g => g.job_number === item.job_number);
    const lineBarColor = item.status === 'Completed' ? 'bg-emerald-500' : (item.status === 'In-Progress' ? 'bg-amber-500' : 'bg-slate-500');

    return `
      <div onclick="openInfoModal(${origIndex})" class="bg-white p-4 rounded-xl border border-slate-200 hover:border-slate-400 hover:shadow-md transition duration-200 cursor-pointer shadow-sm relative overflow-hidden">
        <div class="absolute left-0 top-0 bottom-0 w-1 ${lineBarColor}"></div>
        
        <div class="flex justify-between items-center mb-2 pl-1">
          <span class="text-[9px] font-bold border px-2 py-0.5 rounded-md ${uColor}">${item.urgency}</span>
          <div class="flex items-center gap-1.5">
            <span class="text-[10px] font-black text-slate-400 tracking-wider">${item.job_number || 'Job-000'}</span>
            <span class="text-[9px] font-bold px-2 py-0.5 rounded-md ${sColor}">${item.status}</span>
          </div>
        </div>
        <h4 class="font-bold text-slate-800 text-xs pl-1 mb-1 truncate">${item.subject}</h4>
        <p class="text-slate-500 text-[11px] pl-1 flex items-center gap-1"><i class="fa-solid fa-location-dot text-slate-400 text-[10px]"></i> คลัง/สถานที่: ${item.location}</p>
        
        <div class="border-t border-slate-100 mt-2.5 pt-2 pl-1 flex justify-between items-center text-[10px] text-slate-400">
          <span>ผู้แจ้ง: ${item.reporter_name}</span>
          <span class="text-[#0f172a] font-bold flex items-center gap-0.5">คลิกดูรายละเอียด <i class="fa-solid fa-angle-right text-[8px]"></i></span>
        </div>
      </div>
    `;
  }).join('');
}

function setStatusFilter(status, btnElement) {
  activeFilter = status;
  document.querySelectorAll('.track-tab').forEach(btn => {
    btn.className = "track-tab bg-white border border-slate-200 text-slate-500 px-3 py-2 rounded-lg whitespace-nowrap transition-all";
  });
  if(btnElement) {
    btnElement.className = "track-tab bg-[#0f172a] text-white px-3 py-2 rounded-lg shadow-sm whitespace-nowrap transition-all";
  }
  runFilter();
}

function openInfoModal(index) {
  const data = globalRepairs[index];
  if (!data) return;
  
  const beforeImg = data.photo_before ? `<img src="${data.photo_before}" class="w-full rounded-xl border border-slate-200 bg-slate-50 mt-1.5 max-h-36 object-contain shadow-inner">` : `<p class="text-slate-400 italic text-[11px] mt-1">ไม่ได้แนบรูปหลักฐาน</p>`;
  const afterImg = data.photo_after ? `<img src="${data.photo_after}" class="w-full rounded-xl border border-slate-200 bg-slate-50 mt-1.5 max-h-36 object-contain shadow-inner">` : ``;

  document.getElementById('infoModalBody').innerHTML = `
    <div class="space-y-2">
      <div class="bg-slate-50 p-2.5 rounded-xl border border-slate-100">
        <span class="text-slate-400 font-bold block text-[9px] uppercase tracking-wider">รหัสใบงานซ่อม</span> 
        <b class="text-slate-800 text-sm">${data.job_number || '-'}</b>
      </div>
      <div class="bg-slate-50 p-2.5 rounded-xl border border-slate-100">
        <span class="text-slate-400 font-bold block text-[9px] uppercase tracking-wider">เครื่องจักร / อุปกรณ์</span> 
        <b class="text-[#0f172a]">${data.subject || '-'}</b>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-2 pt-1">
      <p><span class="text-slate-400 font-bold">ระดับความด่วน:</span> ${data.urgency || '-'}</p>
      <p><span class="text-slate-400 font-bold">สถานะงาน:</span> <span class="font-bold text-slate-700">${data.status || '-'}</span></p>
      <p><span class="text-slate-400 font-bold">สถานที่ติดตั้ง:</span> ${data.location || '-'}</p>
      <p><span class="text-slate-400 font-bold">ผู้แจ้งเรื่อง:</span> ${data.reporter_name || '-'}</p>
      <p class="col-span-2"><span class="text-slate-400 font-bold">เบอร์ติดต่อกลับ:</span> ${data.phone || '-'}</p>
    </div>

    <div class="bg-slate-50 p-2.5 rounded-xl border border-slate-100">
      <span class="text-slate-400 font-bold block text-[9px] uppercase tracking-wider">รายละเอียดอาการชำรุด</span>
      <p class="text-slate-700 mt-0.5">${data.description || 'ไม่ได้ระบุคำอธิบายเพิ่มเติม'}</p>
    </div>

    ${data.tech_code ? `
      <div class="bg-amber-50/70 border border-amber-200 p-3 rounded-xl text-amber-900 shadow-sm">
        <span class="text-amber-600 font-bold block text-[9px] uppercase tracking-wider flex items-center gap-1">
          <i class="fa-solid fa-comment-dots text-[10px]"></i> บันทึกหมายเหตุจากช่าง (Remark)
        </span>
        <p class="text-xs font-semibold mt-1">${data.tech_code}</p>
      </div>
    ` : ''}

    <div class="pt-2 border-t border-slate-100">
      <span class="block text-slate-400 font-bold text-[9px] uppercase tracking-wider"><i class="fa-solid fa-camera"></i> รูปภาพก่อนรับซ่อม:</span>
      ${beforeImg}
    </div>

    ${afterImg ? `
      <div class="pt-2 border-t border-slate-100">
        <span class="block text-slate-400 font-bold text-[9px] uppercase tracking-wider"><i class="fa-solid fa-circle-check text-emerald-500"></i> รูปภาพงานซ่อมเสร็จสิ้น:</span>
        ${afterImg}
      </div>
    ` : ''}
  `;
  
  document.getElementById('infoModal').classList.remove('hidden');
  document.body.style.overflow = 'hidden'; 
}

function closeInfoModal() { 
  const modal = document.getElementById('infoModal');
  if(modal) modal.classList.add('hidden'); 
  document.body.style.overflow = 'auto'; 
}
